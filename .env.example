# Taiga credentials already used by TaigaService.
GIT_USER=
TIAGA_PASSWORD=

# Numeric Taiga project ID where inflatable issues will be created.
TAIGA_PROJECT_ID=

# Public Google Sheets URL (the service reads the sheet as CSV through GViz).
INFLATABLE_CATALOG_URL=https://docs.google.com/spreadsheets/d/1I0URF1-jNhRJx7YThKXlUnfgBdojayRUc_H3jELiIQs/edit?gid=0#gid=0

# Shared secret. Generate a long random value and set the same value in
# Google Apps Script > Project Settings > Script Properties.
INFLATABLE_ORDER_WEBHOOK_SECRET=
